{
  "servers": [
    {
      "name": "cmdb",
      "transport": "stdio",
      "command": ".venv/bin/python",
      "args": ["scripts/mcp_servers/cmdb_server.py"],
      "cwd": ".",
      "env": {"CMDB_DATA": "${CMDB_DATA}"},
      "client_timeout_seconds": 5,
      "max_retry_attempts": 1,
      "call_timeout_seconds": 15,
      "tools": {
        "query_asset": {
          "risk": "low",
          "roles": ["employee", "operator", "admin"],
          "description": "查询 CMDB 服务器资产信息（只读）",
          "param_schema": {
            "type": "object",
            "required": ["hostname"],
            "additionalProperties": false,
            "properties": {
              "hostname": {"type": "string"}
            }
          }
        },
        "list_network_devices": {
          "risk": "low",
          "roles": ["employee", "operator", "admin"],
          "description": "列出 CMDB 网络设备（只读，可按机架过滤）",
          "param_schema": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "rack": {"type": "string"}
            }
          }
        },
        "update_asset_owner": {
          "risk": "high",
          "roles": ["operator", "admin"],
          "description": "变更 CMDB 服务器资产负责人（写操作，高风险需审批）",
          "param_schema": {
            "type": "object",
            "required": ["hostname", "new_owner", "reason"],
            "additionalProperties": false,
            "properties": {
              "hostname": {"type": "string"},
              "new_owner": {"type": "string"},
              "reason": {"type": "string"}
            }
          }
        }
      }
    },
    {
      "name": "github",
      "transport": "streamable_http",
      "url": "https://api.githubcopilot.com/mcp/",
      "headers": {"Authorization": "Bearer ${GITHUB_MCP_TOKEN}"},
      "client_timeout_seconds": 10,
      "call_timeout_seconds": 30,
      "tools": {
        "search_repositories": {
          "risk": "low",
          "roles": ["employee", "operator", "admin"],
          "description": "在 GitHub 上按关键词搜索仓库（只读）"
        },
        "list_repositories": {
          "risk": "low",
          "roles": ["employee", "operator", "admin"],
          "description": "列出当前登录用户可见的仓库（只读）"
        },
        "get_issue": {
          "risk": "low",
          "roles": ["employee", "operator", "admin"],
          "description": "查询指定 issue 的详情（只读）"
        },
        "get_issue_comments": {
          "risk": "low",
          "roles": ["employee", "operator", "admin"],
          "description": "查询指定 issue 的评论列表（只读）"
        },
        "create_issue": {
          "risk": "high",
          "roles": ["operator", "admin"],
          "description": "在仓库中创建 issue（写操作，需审批）"
        }
      }
    }
  ]
}

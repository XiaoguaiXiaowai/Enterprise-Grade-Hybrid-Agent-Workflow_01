# ===== 应用 =====
APP_DB_PATH=./data/app.db
APP_ENV=production
SECRET_KEY=change-me-to-a-long-random-string

# ===== 模型：主用(OpenRouter) ⇄ 兜底(Ollama) ⇄ 离线 reader =====
# 路由出的模型名会带前缀：openrouter:... 走 OpenRouter，ollama:... 走本地 Ollama

# --- 主用提供方（OpenRouter，OpenAI 兼容 /v1/chat/completions）---
OPENROUTER_API_KEY=sk-or-v1-
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# --- Ollama 通用服务器地址（可配置，Docker 内网用 http://ollama:11434/v1）---
OLLAMA_BASE_URL=http://106.12.156.134:11434/v1

# --- 工单意图/风险分类 ---
CLASSIFIER_MODEL=nvidia/nemotron-3.5-content-safety:free            # 主用（非推理模型，结构化输出稳定且快）
CLASSIFIER_FALLBACK_MODEL=deepseek-r1:1.5b        # 兜底：Ollama 模型（先 ollama pull deepseek-r1:1.5b）

# --- 相关性校验专用 --- （不填则复用 CLASSIFIER_MODEL / CLASSIFIER_FALLBACK_MODEL）
RELEVANCE_MODEL=nvidia/nemotron-3.5-content-safety:free            # 主用（非推理）
RELEVANCE_FALLBACK_MODEL=deepseek-r1:1.5b

# --- 提示词重写专用 --- （不填则复用 CLASSIFIER_MODEL / CLASSIFIER_FALLBACK_MODEL）
REWRITE_MODEL=nvidia/nemotron-3.5-content-safety:free            # 主用（非推理）
#REWRITE_MODEL=liquid/lfm-2.5-2.6b:free
REWRITE_FALLBACK_MODEL=deepseek-r1:1.5b

# --- Agent 编排 / 计划执行（SDK 主链路 + 传统网关）---
AGENT_MODEL=nvidia/nemotron-3.5-lightning:free                 # 主用：OpenRouter 上的任意模型 id
AGENT_FALLBACK_MODEL=deepseek-r1:1.5b             # 兜底：Ollama 模型（先 ollama pull deepseek-r1:1.5b）

# --- 路由默认模型（未显式设置 AGENT_MODEL 时按意图给默认）---
ROUTER_MODEL_DEFAULT=nvidia/nemotron-3.5-lightning:free        # 知识/查询/排障
ROUTER_MODEL_HIGH_RISK=openrouter/free      # 变更类 / 高风险升格

# ===== 预算 =====
BUDGET_MAX_STEPS=25
BUDGET_MAX_TOKENS=200000
BUDGET_MAX_SECONDS=600

# ===== LLM 调用参数（整改②：温度 / max_tokens / 成本单价外部化）=====
LLM_TEMPERATURE=0
# 注意：max_tokens 是「含推理 token 的总输出预算」。推理类模型（如 liquid/*）必须调大，
# 否则思考阶段就把预算烧完、返回空 content。当前主用为非推理模型，512 足够且快速。
LLM_MAX_TOKENS_CLASSIFY=512
LLM_MAX_TOKENS_REWRITE=512
# 成本估算单价（美元/百万 token）；默认 0=未定价，配置后 /metrics 的 cost 为按 token 用量的估算
LLM_COST_PER_1M_TOKENS=0

# ===== 上下文装配 / 守卫阈值（整改②）=====
CTX_MAX_HISTORY=8            # 上下文只保留最近 N 条历史
CTX_MAX_OBS_LEN=1200         # 单条 observation 超过则压缩
CTX_MIN_TRUNCATE=30          # 历史条数超过则触发 auto-compact
DEDUP_WINDOW_MINUTES=5       # 重复动作检测时间窗（分钟）

# ===== 安全参数（整改②）=====
PBKDF2_ITERATIONS=100000     # 密码哈希迭代次数
SESSION_TTL_HOURS=12         # 会话有效期（小时）
SESSION_TOKEN_BYTES=32       # 会话 token 随机字节数

# ===== 函数级调用日志 =====
# off（默认）| info（记录请求路由+核心函数进入/退出）| debug（同 info，预留扩展）
APP_LOG_LEVEL=info
# 日志目录（相对项目根或绝对路径；整改⑦）
LOG_DIR=logs

# ===== 演示播种（整改⑥：生产环境不自动播种，密码不再写死 pass123）=====
# 非生产环境自动播种演示账户（admin/operator/employee）的密码；缺省随机生成
#SEED_USER_PASSWORD=change-me-demo-password

# ===== 前端(web 服务用) =====
NEXT_PUBLIC_API_URL=http://localhost:80

# ===== 向量知识库（本地 RAG）=====
# LanceDB 向量库目录（相对项目根）
VECTOR_DB_PATH=./data/vector-kb
# 主用 embedding（OpenRouter）：默认 nvidia/nemotron-3-embed-1b:free
EMBEDDING_MODEL=
EMBEDDING_PRIMARY_BASE_URL=https://openrouter.ai/api/v1
# 兜底 embedding（Ollama）：EMBEDDING_BASE_URL 即 Ollama 端点
EMBEDDING_FALLBACK_MODEL=bge-m3:latest      # 先 ollama pull bge-m3
EMBEDDING_BASE_URL=http://39.152.146.232:11434/v1
# 输出维度（主用 nemotron 默认 1024；bge-m3 也 1024，换模型需同步改）
EMBEDDING_DIM=1024
# 切块参数（递归切分：段落→句子→子句→字符，含重叠）
VECTOR_CHUNK_SIZE=500
VECTOR_CHUNK_OVERLAP=200
# 每次语义检索返回条数
VECTOR_TOP_K=3

# ===== 建单输入校验 / 提示词重写（M5）=====
# 建单时先由 LLM 确认输入与『企业 IT 工单』领域是否相关；不相关则拒绝建单并提示（默认开）
INPUT_RELEVANCE_CHECK=true
# 工单内容不直接并入提示词，先用 LLM 总结归纳后再并入（默认开）
PROMPT_REWRITE=true


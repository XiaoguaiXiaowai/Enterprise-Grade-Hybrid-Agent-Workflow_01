# ===== 应用 =====
APP_DB_PATH=./data/app.db
APP_ENV=production
SECRET_KEY=change-me-to-a-long-random-string

# ===== 模型 =====
# provider: openai | ollama | reader(离线占位,无需密钥)
MODEL_PROVIDER=reader
MODEL_NAME=qwen2.5:7b
# OpenAI 官方，或任意兼容 /v1/chat/completions 的网关
OPENAI_API_KEY=
OPENAI_BASE_URL=
# Ollama 本地（Docker 内网用 http://ollama:11434/v1）
OLLAMA_BASE_URL=http://127.0.0.1:11434/v1

# ===== 预算 =====
BUDGET_MAX_STEPS=25
BUDGET_MAX_TOKENS=200000
BUDGET_MAX_SECONDS=600

# ===== 前端(web 服务用) =====
NEXT_PUBLIC_API_URL=http://localhost:80

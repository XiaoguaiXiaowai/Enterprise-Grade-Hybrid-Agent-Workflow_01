# ===== 应用 =====
APP_DB_PATH=./data/app.db
APP_ENV=production
SECRET_KEY=change-me-to-a-long-random-string

# ===== 模型 =====
# 兼容层仍可用（provider: openai | ollama | reader），但 M4 起优先走 OpenAI Agents SDK：
#   primary = openrouter（通过 OPENROUTER_* 配置），fallback = ollama（OLLAMA_*）
# 路由出的模型名会带前缀：openrouter:... 走 OpenRouter，ollama:... 走本地 Ollama
MODEL_PROVIDER=openrouter
MODEL_NAME=openrouter/free
# OpenRouter（OpenAI 兼容，key 用你自己的 OpenRouter Key）
OPENROUTER_API_KEY=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
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# Ollama 本地（Docker 内网用 http://ollama:11434/v1）
OLLAMA_BASE_URL=http://127.0.0.1:11434/v1
OLLAMA_MODEL_NAME=qwen2.5:7b
# 兼容网关（可选，M2 遗留，SDK 模式下不再需要）
# OPENAI_API_KEY=
# OPENAI_BASE_URL=

# ===== 预算 =====
BUDGET_MAX_STEPS=25
BUDGET_MAX_TOKENS=200000
BUDGET_MAX_SECONDS=600

# ===== 函数级调用日志 =====
# off（默认）| info（记录请求路由+核心函数进入/退出）| debug（同 info，预留扩展）
APP_LOG_LEVEL=info

# ===== 前端(web 服务用) =====
NEXT_PUBLIC_API_URL=http://localhost:80

# ===== 向量知识库（本地 RAG，方案 A）=====
# LanceDB 向量库目录（相对项目根）
VECTOR_DB_PATH=./data/vector-kb
# Ollama embeddings 端点与模型（先 ollama pull bge-m3）
EMBEDDING_BASE_URL=http://127.0.0.1:11434/v1
EMBEDDING_MODEL=bge-m3:latest
# bge-m3 输出维度（默认 1024，勿改除非换模型）
EMBEDDING_DIM=1024
# 切块参数
VECTOR_CHUNK_SIZE=300
VECTOR_CHUNK_OVERLAP=60
# 每次语义检索返回条数
VECTOR_TOP_K=3
